            "scorer.actual.gamma_x=median",
            "scorer.actual.gamma_x_scope=global",
            "scorer.actual.gamma_a=median",
            "scorer.actual.use_annotator_embeddings=false",
            "scorer.actual.annotator_lambda=0.0",
            "scorer.actual.class_prior=kernel",
            "scorer.actual.class_prior_strength=1.0",
            "scorer.actual.class_prior_lambda=0.0",
            "scorer.actual.use_ess_class_prior=true",
            "scorer.actual.tau_class_prior=1.0",
            "scorer.actual.sample_class_prior=true",
            "scorer.actual.use_ess_beta=true",
            "scorer.actual.tau_beta=1.0",
            "scorer.actual.use_ess_label_dirichlet=true",
            "scorer.actual.tau_label_dirichlet=1.0",
            "scorer.actual.sample_label_dirichlet=true",
            "scorer.actual.channel_label_dirichlet_strength=1.0",
            "scorer.actual.channel_wrong_label_mode=normalize",
            "scorer.actual.top_m=null",
            "scorer.actual.gain_type=entropy",
            "scorer.actual.n_mc_samples=10",
            "scorer.actual.gain_ucb_quantile=null"
          ],
          "tags": {
            "method_family": "ks_bag",
            "selected_variant": "main"
          }
        },
        "performance": {
          "overrides": ["scorer@scorer.actual=performance"],
          "tags": {
            "method_family": "reliability"
          }
        },
        "ig_gain": {
          "overrides": ["scorer@scorer.actual=ig_gain"],
          "tags": {
            "method_family": "information_gain"
          }
        },
        "label_minority": {
          "overrides": ["scorer@scorer.actual=label_minority"],
          "tags": {
            "method_family": "label_history"
          }
        },
        "random": {
          "overrides": ["scorer@scorer.actual=random"],
          "tags": {
            "method_family": "random"
          }
        },
        "semantic_diversity": {
          "overrides": ["scorer@scorer.actual=semantic_diversity"],
          "tags": {
            "method_family": "diversity"
          }
        },
        "representation_diversity": {
          "overrides": ["scorer@scorer.actual=representation_diversity"],
          "tags": {
            "method_family": "diversity"
          }
        }
      }
