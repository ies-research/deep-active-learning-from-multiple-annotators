          "overrides": [
            "dataset=audiomnist10",
            "al=audiomnist10",
            "simulation=audiomnist10",
            "embedder@classification_embedder=wav2vec",
            "embedder@simulation_embedder=wavlm"
          ]
        },
        "banking77": {
          "overrides": [
            "dataset=banking77",
            "al=banking77",
            "simulation=banking77",
            "embedder@classification_embedder=mpnetv2",
            "embedder@simulation_embedder=minilmv2"
          ]
        },
        "dermamnist7": {
          "overrides": [
            "dataset=dermamnist7",
            "al=dermamnist7",
            "simulation=dermamnist7",
            "embedder@classification_embedder=dinov2",
            "embedder@simulation_embedder=clip"
          ]
        },
        "dopanim": {
          "overrides": [
            "dataset=dopanim",
            "al=dopanim",
            "~simulation",
            "embedder@classification_embedder=dinov2",
            "~embedder@simulation_embedder"
          ]
        },
        "food101": {
          "overrides": [
            "dataset=food101",
            "al=food101",
            "simulation=food101",
            "embedder@classification_embedder=dinov2",
            "embedder@simulation_embedder=clip"
          ]
        },
        "letter26": {
          "overrides": [
            "dataset=letter26",
            "al=letter26",
            "simulation=letter26",
            "embedder@classification_embedder=identity_tabular",
            "embedder@simulation_embedder=identity_tabular"
          ]
        },
        "skits2i14": {
          "overrides": [
            "dataset=skits2i14",
            "al=skits2i14",
            "simulation=skits2i14",
            "embedder@classification_embedder=wav2vec",
            "embedder@simulation_embedder=wavlm"
          ]
        },
        "trec6": {
          "overrides": [
            "dataset=trec6",
            "al=trec6",
            "simulation=trec6",
            "embedder@classification_embedder=mpnetv2",
            "embedder@simulation_embedder=minilmv2"
          ]
        }
      }
    },
    {
      "name": "classifier",
      "type": "choices",
      "values": {
        "majority_voting": {
          "overrides": [
            "classifier=majority_voting",
            "training=default"
          ],
          "tags": {
            "classifier_noise_model": "none"
          }
        },
        "geo_reg_f": {
          "overrides": [
            "classifier=geo_reg_f",
            "training=default"
          ],
          "tags": {
            "classifier_noise_model": "class_dependent"
          }
        },
        "annot_mix_gating": {
          "overrides": [
            "classifier=annot_mix_gating",
            "training=default"
          ],
          "tags": {
            "classifier_noise_model": "instance_class_dependent"
          }
        }
      }
    },
    {
      "name": "method",
      "type": "choices",
      "values": {
        "ks_bag_full_confusion_channel_prior_s3": {
          "overrides": [
